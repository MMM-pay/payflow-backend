# --- Stellar ---
STELLAR_NETWORK=testnet
# One RPC endpoint, or several comma-separated. On a failure or a lagging
# endpoint the client switches to the next; /health reports the active one.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Extra networks (one instance can serve several) ---
# Comma-separated names besides the default above. Each name gets a route
# segment /api/<name>/... and its own database (see DATABASE_PATH below);
# configure it with <NAME>_ prefixed variables, e.g. NETWORKS=mainnet plus:
#
# MAINNET_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.example
# MAINNET_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# MAINNET_PLAN_REGISTRY_ID=
# MAINNET_VAULT_ID=
# MAINNET_SUBSCRIPTION_ID=
# MAINNET_INDEXER_START_LEDGER=5110418
# MAINNET_DATABASE_PATH=/data/payflow-mainnet.db
NETWORKS=

# --- Deployed contract IDs (from payflow-contract/scripts/deploy.sh) ---
PLAN_REGISTRY_ID=CDQ5EJTVXXX2CBMHWP3BGGUDHSK6D4I25IF5XXH3QGL2TNTBMJUOFKDB
VAULT_ID=CBNQEWSYYQOKNX5KB62OFT6ID5TCVSWN4PS4AXAJK6IWUEXOLVN6DXII
SUBSCRIPTION_ID=CD5YZUJU6WLFIHGAV4J2BV42GCVZE5ZGDUGSW5CBRIA47TQHSZZW3XMM
TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# --- Keeper ---
# Secret key (S...) of the account that pays fees to settle due mandates.
# The keeper collects no funds; it only triggers charge(). Leave empty to
# run the indexer and API without settlement.
KEEPER_SECRET=
# Standby key for zero-downtime rotation. When set, the keeper signs with
# KEEPER_SECRET first and switches to this key mid-pass if the primary cannot
# pay (leaked, drained or deleted). After a pass succeeds with it, the log
# says the old key can be retired. Promote it to KEEPER_SECRET and send the
# process SIGHUP to reload without a restart. Leave empty to disable.
KEEPER_SECRET_NEXT=
# Extra channel accounts for parallel settlement, comma-separated S... keys.
# Each channel signs and sequences its own transactions (paying its own fees),
# so one pass settles mandates across accounts at once instead of one account
# at a time; due mandates are distributed over the live channels dynamically.
# KEEPER_SECRET stays the first channel and these keys need only XLM for fees —
# `charge` is permissionless, so no channel key holds user funds or on-chain
# authority. Duplicates are ignored. Leave empty for a single-key setup.
KEEPER_CHANNEL_SECRETS=
KEEPER_INTERVAL_MS=60000
# Which due mandate to settle first: `oldest` (due date ascending, the default)
# or `largest` (amount descending, to prioritise high-value mandates under a
# fee budget). Re-read on SIGHUP like the other keeper settings.
KEEPER_ORDER=oldest
# Only settle mandates payable to these merchants, comma-separated G... addresses.
# Leave empty to settle every merchant's due mandates.
KEEPER_MERCHANTS=
# Fee percentile used for charge transactions (50, 60, 70, 80, 90, 95 or 99).
KEEPER_FEE_PERCENTILE=90
# Maximum inclusion fee in stroops; congested transactions retry once up to this cap.
KEEPER_MAX_FEE=100000
# Use charge_many when supported; otherwise the keeper falls back to single charges.
KEEPER_BATCH=true
# Mandates per charge_many transaction (2–25).
KEEPER_BATCH_SIZE=10
KEEPER_ENABLED=false

# --- Indexer ---
INDEXER_INTERVAL_MS=10000
# How many 8,000-ledger windows one pass may fetch at once. Windows are still
# applied in ledger order and the cursor advances per applied window; set to 1
# for strictly sequential reads.
INDEXER_FETCH_CONCURRENCY=4
INDEXER_START_LEDGER=5110418

# --- Full-history archive (optional) ---
# Backfills the gap between the stored cursor and the oldest ledger the RPC
# node still serves, so an outage longer than RPC retention does not silently
# shrink the projection. The archive must answer the same getEvents shape as
# Soroban RPC (startLedger, endLedger, limit, cursor). Leave empty to report
# and refuse gaps instead of backfilling them.
ARCHIVE_URL=
# Advance the indexer cursor past a gap the RPC cannot serve, accepting that
# history in the gap is lost and the projection will under-report. Without
# this the indexer refuses to advance past a gap until ARCHIVE_URL is set.
ALLOW_GAPS=false

# --- Reconciliation ---
# How often the reconciler re-checks a sample of active mandates against the
# contract state, repairing drift an indexer gap or bug left behind (ms).
RECONCILE_INTERVAL_MS=600000
# Active mandates sampled per reconcile pass; each sample costs one read-only
# RPC simulation.
RECONCILE_SAMPLE_SIZE=25

# --- Server ---
PORT=8080
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
DATABASE_PATH=./payflow.db
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Serve the Prometheus endpoint at /metrics (gauges and counters in the
# Prometheus text format). Off by default: the metrics are operational data,
# so only expose them where something scrapes them.
METRICS_ENABLED=false
# Set to an OTLP/HTTP collector (e.g. http://localhost:4318) to export traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# How long shutdown waits for in-flight passes before closing the database.
SHUTDOWN_TIMEOUT_MS=15000

# --- Admin ---
# Bearer token for the /admin operator endpoints (trigger a reindex, run a
# keeper pass, read the backoff list). Leave empty to keep /admin disabled.
ADMIN_TOKEN=

# --- Webhooks ---
# Seconds a rotated webhook secret keeps signing beside the new one
# (POST /api/webhooks/:id/rotate), so receivers can switch without a gap.
# 0 retires the old secret at once; at most 604800 (seven days).
WEBHOOK_SECRET_OVERLAP_S=86400

# --- SEP-10 sign-in (optional) ---
# Secret seed (S...) of the server account that signs challenges at
# /api/auth; publish its public key as SIGNING_KEY and the endpoint as
# WEB_AUTH_ENDPOINT in the home domain's stellar.toml. Leave empty to disable.
SEP10_SIGNING_KEY=
# HMAC-SHA256 key for the issued JWTs, at least 32 characters.
SEP10_JWT_SECRET=
# The home domain clients authenticate to, e.g. payflow.example.
SEP10_HOME_DOMAIN=
# The domain serving /api/auth; defaults to SEP10_HOME_DOMAIN.
SEP10_WEB_AUTH_DOMAIN=
# JWT lifetime in seconds (60-86400).
SEP10_JWT_TTL_S=3600

